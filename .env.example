PORT=3000
ALLOWED_ORIGIN=http://localhost:3000
RATE_LIMIT_MAX=100

# API Keys por cliente. Se guardan en memoria como hash SHA-256,
# nunca en claro. Ver src/data/apiKeys.js
API_KEY_POSTMAN=REEMPLAZAR_CON_API_KEY_SEGURA
API_KEY_ADMIN=REEMPLAZAR_CON_API_KEY_SEGURA
API_KEY_MOVIL=REEMPLAZAR_CON_API_KEY_SEGURA

# Secreto con el que se firman los JWT y tiempo de vida del token.
# El secreto nunca va en el codigo. Si falta, el login no puede
# generar tokens. Ver src/utils/jwt.util.js
JWT_SECRET=REEMPLAZAR_CON_SECRETO_JWT_SEGURO
JWT_EXPIRES_IN=1h

# Administrador inicial (bootstrap). Se crea al arrancar la API
# si no existe. Nunca se crea por HTTP. Ver crearAdministradorInicial
# en src/services/usuarios.service.js
ADMIN_NOMBRE=Administrador Hospital
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=REEMPLAZAR_CON_PASSWORD_SEGURO

# Conexion a PostgreSQL en Supabase.
# Nunca se escribe en el codigo ni se sube al repositorio.
# Supabase -> Connect. En Windows con IPv4 suele ir mejor el
# Session pooler (puerto 5432). El Transaction pooler usa 6543.
DATABASE_URL=postgresql://USUARIO:CONTRASENA@HOST:5432/postgres

## Database configuration... 
